# A API appdetails da Steam Store não exige chave.

# Quantos jogos coletar, do início da lista. Padrão 1000, máximo 5000.
TARGET_APPS=1000

# Consultas por minuto, somando todas as threads. A Steam responde 429 bem abaixo de 200/min. 40/min evita 429.
RATE_PER_MINUTE=40

# Requisições ao mesmo tempo. O ritmo global continua sendo RATE_PER_MINUTE.
CONCURRENT_REQUESTS=4
